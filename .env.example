# ─────────────────────────────────────────────────────────────
# NexusPay Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
APP_URL=http://localhost:5173   # Public base URL used in reset email links
NODE_ENV=development

# ── Email (SMTP) ─────────────────────────────────────────────
# Leave EMAIL_HOST unset (or set EMAIL_DEV_PREVIEW=true) in dev
# to print reset links to the console instead of sending real email.

# Gmail example:
#   1. Enable 2FA on your Google account
#   2. Go to myaccount.google.com → Security → App Passwords
#   3. Generate an app password and paste it as EMAIL_PASS
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-app-password-here
EMAIL_FROM=NexusPay <no-reply@nexuspay.com>

# Set to "true" to log reset URLs to the console (no email sent)
EMAIL_DEV_PREVIEW=true

# ─────────────────────────────────────────────────────────────
# MySQL (Sequelize)
# ─────────────────────────────────────────────────────────────
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_USER=nexuspay_app
DB_MYSQL_PASSWORD=change_me_before_deploy
DB_MYSQL_NAME=nexuspay

# Connection pool — optional, defaults to 10; must be an integer 1–100
DB_MYSQL_POOL_MAX=10

# Set to "true" to enable SSL (requires DB_MYSQL_SSL_CA)
DB_MYSQL_SSL=false
DB_MYSQL_SSL_CA=/path/to/ca-cert.pem

# ─────────────────────────────────────────────────────────────
# MongoDB (Mongoose)
# ─────────────────────────────────────────────────────────────
DB_MONGO_URI=mongodb://localhost:27017/nexuspay

# Set to "true" to enable TLS (requires DB_MONGO_TLS_CA)
DB_MONGO_TLS=false
DB_MONGO_TLS_CA=/path/to/mongo-ca.pem

# ─────────────────────────────────────────────────────────────
# JWT (used for session refresh tokens — min 32 characters)
# NEVER set a real secret here — use a securely generated random value in .env
# ─────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_at_least_32_random_characters_here

# ─────────────────────────────────────────────────────────────
# Audit log retention (optional — omit to keep logs forever)
# ─────────────────────────────────────────────────────────────
# AUDIT_LOG_RETENTION_DAYS=365

# ─────────────────────────────────────────────────────────────
# FX routing (optional — omit to use server/data/exchange-rates.json)
# ─────────────────────────────────────────────────────────────
# FX_RATES_JSON={"edges":[...]}
